<UserControl x:Class="NV.CT.ConfigManagement.View.BreatheVoiceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf.Controls.MarkableTextBox;assembly=MaterialDesignThemes.Wpf"
             xmlns:comboBox="clr-namespace:MaterialDesignThemes.Wpf.Controls.MarkableComboBox;assembly=MaterialDesignThemes.Wpf"
             xmlns:res="clr-namespace:NV.CT.Language;assembly=NV.CT.Language"
             xmlns:converter="clr-namespace:NV.CT.UI.Controls.Converter;assembly=NV.CT.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Nanovision.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <Style x:Key="VoiceButtonStyle" BasedOn="{StaticResource NanoButtonStyle}" TargetType="{x:Type Button}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource BaseBackgroundColor}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="IconFactoryPathStyle" BasedOn="{StaticResource IconFactory}" TargetType="{x:Type Path}">
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Stretch" Value="Fill" />
                <Setter Property="ToolTip" Value="{x:Static res:LanguageResource.ToolTip_Factory}" />
                <Setter Property="Fill" Value="{StaticResource PatOrderIconFillBrush}" />
            </Style>
            <Style x:Key="LoginPathStyle" BasedOn="{StaticResource Login}" TargetType="{x:Type Path}">
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Stretch" Value="Fill" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ToolTip" Value="{x:Static res:LanguageResource.ToolTip_Custom}" />
                <Setter Property="Fill" Value="{StaticResource PatOrderIconFillBrush}" />
            </Style>
            <!--播放语音-->
            <ControlTemplate x:Key="PlayButtonTemplate" TargetType="Button">
                <Border Background="{TemplateBinding Background}">
                    <Path Stretch="Fill" Cursor="Hand" 
                          Width="23" Height="23" 
                          Style="{StaticResource VoicePlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <!-- 通用的语音按钮样式 -->
            <Style x:Key="GenericVoiceButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PatOrderIconFillBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="23"/>
                <Setter Property="Height" Value="23"/>
                <Setter Property="Margin" Value="15 0 0 0"/>
                <Setter Property="Template" Value="{StaticResource PlayButtonTemplate}"/>
                <Setter Property="ToolTip" Value="Set Playlist"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="Transparent"  Margin="0,2,0,0" CornerRadius="10,10,10,10" BorderThickness="1,1,1,1" BorderBrush="#5A5A89" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,0,0,0" >
                <Label Grid.ColumnSpan="2" 
                       Name="lblTabTitle" 
                       FontSize="16" FontWeight="Bold" 
                       Margin="0,0,0,0" 
                       Content="Breathe Voice List"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center" 
                       Height="34" 
                       Foreground="#FFC6C6EC" />
                <Rectangle Grid.Column="0" 
                           VerticalAlignment="Bottom" Stroke="#3044D9" 
                           Height="3" StrokeThickness="3" 
                           Width="{Binding ElementName=lblTabTitle,Path=ActualWidth}" HorizontalAlignment="Left"
                           Margin="-3,0,0,8" 
                           SnapsToDevicePixels="True" Visibility="Visible" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="490"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button  Height="40" Width="120" Opacity="1" Margin="0,0,10,0"
                             Command="{Binding Commands[VoiceAddCommand]}" 
                             Content="{x:Static res:LanguageResource.Content_Add}" Style="{StaticResource VoiceButtonStyle}"/>
                    <Button  Height="40" Width="120" Opacity="1" Margin="0,0,10,0" 
                             Command="{Binding Commands[VoiceEditCommand]}"
                             Content="{x:Static res:LanguageResource.Content_Edit}" IsEnabled="{Binding IsFactory}" Style="{StaticResource VoiceButtonStyle}"/>
                    <Button  Height="40" Width="120" Opacity="1" Margin="0,0,10,0" 
                             Command="{Binding Commands[VoiceDeleteCommand]}" 
                             Content="{x:Static res:LanguageResource.Content_Delete}" IsEnabled="{Binding IsFactory}" Style="{StaticResource VoiceButtonStyle}"></Button>
                </StackPanel>
            </Grid>
            <!-- 呼吸语音Group列表 -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Left">
                <DataGrid Grid.Row="2" ItemsSource="{Binding BreatheVoicesGroup}" SelectedItem="{Binding SelectedVoiceGroup, Mode=TwoWay}" SelectionMode="Single"
                          Style="{StaticResource CommonDataGrid}" Margin="0 5 5 5">
                    <DataGrid.Columns>
                        <!--Group name-->
                        <DataGridTemplateColumn Width="*" MinWidth="100"  Header="{x:Static res:LanguageResource.Header_Name}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"  Style="{StaticResource DataGridContentTextBlock}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--Group description-->
                        <DataGridTemplateColumn Width="*" MinWidth="100" Header="{x:Static res:LanguageResource.Header_Description}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource DataGridContentTextBlock}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--Voices count-->
                        <DataGridTemplateColumn Width="100" MinWidth="80" Header="Count">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="15 0 0 0" Text="{Binding Count, NotifyOnSourceUpdated=True}" Style="{StaticResource DataGridContentTextBlock}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--Factory or Custom-->
                        <DataGridTemplateColumn Width="80" MinWidth="80" Header="{x:Static res:LanguageResource.Header_Factory}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Background="Transparent" HorizontalAlignment="Left" Cursor="Arrow" Focusable="False" IsEnabled="{Binding IsFactory,Mode=OneTime}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <Path Style="{StaticResource IconFactoryPathStyle}" Margin="15 0 0 0" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <Path Style="{StaticResource LoginPathStyle}" Margin="15 0 0 0" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--Default-->
                        <DataGridTemplateColumn Width="80" MinWidth="80" Header="{x:Static res:LanguageResource.Header_Default}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Path Style="{StaticResource RightPath}" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15 0 0 0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--Set playlist into auxboard-->
                        <DataGridTemplateColumn Width="100" MinWidth="80" Header="Set Playlist">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GenericVoiceButtonStyle}"
                                            Command="{Binding DataContext.Commands[VoicePlayCommand],RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=DataGrid}}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor,AncestorType=DataGridRow}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
